DATABASE_URL=postgresql+asyncpg://user:password@postgres:5432/mailaiworker

REDIS_URL=redis://redis:6379/0

STORAGE_ROOT=/storage

# Secret key used to encrypt/decrypt credentials stored in the database.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
MASTER_KEY=change-me-to-a-random-secret

LLM_BASE_URL=http://fastapi:8000/v1

LLM_API_KEY=your-api-key

LLM_MODEL=qwen2.5-7b-instruct

# Telegram — optional, leave empty to disable review notifications
# Create a bot via @BotFather, get your chat_id via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SMTP — required to send query results via email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASSWORD=your-app-password
REPORT_RECIPIENT=recipient@email.com